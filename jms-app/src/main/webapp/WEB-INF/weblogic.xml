<?xml version="1.0" encoding="UTF-8"?>
<!-- Maps the web.xml references to the JNDI names created by create_domain.py -->
<wls:weblogic-web-app xmlns:wls="http://xmlns.oracle.com/weblogic/weblogic-web-app"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- DataSource 'scottDS' -->
  <wls:resource-description>
    <wls:res-ref-name>jdbc/scottDS</wls:res-ref-name>
    <wls:jndi-name>jdbc/scottDS</wls:jndi-name>
  </wls:resource-description>

  <!-- Connection factory 'ScottCF' in module 'ScottJMSModule' -->
  <wls:resource-description>
    <wls:res-ref-name>jms/connectionFactory</wls:res-ref-name>
    <wls:jndi-name>jms/CF</wls:jndi-name>
  </wls:resource-description>

  <!-- Queue 'ScottQueueParams' in module 'ScottJMSModule' -->
  <wls:resource-env-description>
    <wls:resource-env-ref-name>jms/scottQueue</wls:resource-env-ref-name>
    <wls:jndi-name>jms/scottQueue</wls:jndi-name>
  </wls:resource-env-description>

  <wls:context-root>/scottapp</wls:context-root>

</wls:weblogic-web-app>